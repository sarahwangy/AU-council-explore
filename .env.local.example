# Database (Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require&channel_binding=require"

# Mapbox (public token — safe to expose in browser)
NEXT_PUBLIC_MAPBOX_TOKEN="pk.xxx"

# App base URL
NEXT_PUBLIC_BASE_URL="http://localhost:3010"

# Cron job secret (protect /api/cron endpoints)
CRON_SECRET="your-cron-secret"

# Eventbrite API
EVENTBRITE_TOKEN="your-eventbrite-token"

# Humanitix API
HUMANITIX_API_KEY="your-humanitix-api-key"

# Resend (email notifications)
RESEND_API_KEY="re_xxx"

# Anthropic (AI chat feature)
ANTHROPIC_API_KEY="sk-ant-xxx"

# Test email (for local dev/testing)
TEST_EMAIL="your@email.com"
